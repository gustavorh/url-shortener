# Plantilla de la config de producción de Linkly.
# En prod-host, copiar a ~/services/linkly/.env y rellenar los secretos reales.
# NUNCA commitear el .env real.

NODE_ENV=production
PORT=3000

# URL pública de la app. Se hornea en el bundle del cliente en tiempo de build
# (NEXT_PUBLIC_*) y se usa para construir los short links. El acceso público es
# vía Traefik (hermes) en HTTPS; Caddy en prod-host solo recibe el tráfico http
# interno en :8080. Por eso aquí va el host HTTPS público, sin puerto.
NEXT_PUBLIC_BASE_URL=https://linkly.home.gustavorh.com

# Auth.js (next-auth v5) — secreto para firmar los JWT de sesión.
# Generar con: openssl rand -base64 32
AUTH_SECRET=CHANGEME_use_a_long_random_secret

# MySQL de producción (servidor existente 10.0.30.5, base y usuario dedicados).
DB_HOST=10.0.30.5
DB_PORT=3306
DB_USER=linkly
DB_PASSWORD=CHANGEME
DB_NAME=linkly_prod

# Redis del propio stack (cola BullMQ). El host `redis` es el nombre del
# servicio en docker-compose.
REDIS_URL=redis://redis:6379

# Opcional: concurrencia del worker de clicks (default 5).
# CLICK_WORKER_CONCURRENCY=5
